# ===========================================
# Smart OTA Fleet Manager - Environment Config
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.

# --- PostgreSQL ---
POSTGRES_USER=fleet_admin
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=fleet_manager
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Backend ---
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# First admin account (created on first startup)
ADMIN_EMAIL=admin@fleet.local
ADMIN_PASSWORD=CHANGE_ME_admin_password

# Public URL - set to ngrok URL for cross-network access
# This is the URL that ESP32 devices will use to download firmware
PUBLIC_BASE_URL=http://localhost:8000

# --- MQTT Broker ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=fleet_backend
MQTT_PASSWORD=CHANGE_ME_mqtt_password

# --- Firmware Storage ---
FIRMWARE_STORAGE_PATH=/app/storage
MAX_FIRMWARE_SIZE_MB=4

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- Ngrok (optional, for cross-network access) ---
# NGROK_AUTHTOKEN=your_ngrok_auth_token
# NGROK_API_URL=https://your-subdomain.ngrok-free.app
# NGROK_MQTT_URL=tcp://your-tcp-tunnel.ngrok-free.app:port
